# 服务端口（8000/8001 被本机其它常驻服务占用，这里用 7801）
HUNTER_PORT=7801
# 数据目录：数据库、登录态、日志、截图
HUNTER_DATA_DIR=~/.ruic-goofish-hunter
# 当前网关拦截无头浏览器，必须保持 false（窗口可最小化/移到角落）
HUNTER_HEADLESS=false
# msedge | chrome | chromium
HUNTER_BROWSER_CHANNEL=msedge
# 留空 = 直连并绕过系统代理；需要代理时填 http://127.0.0.1:7897
HUNTER_PROXY=
# 详情并发与调用间隔
HUNTER_DETAIL_CONCURRENCY=3
HUNTER_CALL_INTERVAL=0.35
# 默认关注间隔（秒）
HUNTER_DEFAULT_INTERVAL=300
# 详情缓存（小时）
HUNTER_DETAIL_TTL_HOURS=6
